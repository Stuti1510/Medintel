# MEDINTEL AI - Environment Configuration Example

# Database (PostgreSQL URL or SQLite fallback)
DATABASE_URL=sqlite:///./medintel.db

# LLM Configuration (Options: demo, gemini, openai)
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
DEMO_MODE=true

# Transformer Configuration
TRANSFORMER_MODEL=dmis-lab/biobert-v1.1
RAG_VECTOR_PATH=rag/vectorstore/medical_index.json
